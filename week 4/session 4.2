
import java.util.*;

public class Main {
    static HashMap<Integer, Double> accounts = new HashMap<>();

    static void deposit(int acc, double amount) {
        if (accounts.containsKey(acc) && amount > 0) {
            accounts.put(acc, accounts.get(acc) + amount);
            System.out.println("Deposit Successful");
        } else {
            System.out.println("Invalid Transaction");
        }
    }

    static void withdraw(int acc, double amount) {
        if (accounts.containsKey(acc) &&
            amount > 0 &&
            accounts.get(acc) >= amount) {

            accounts.put(acc, accounts.get(acc) - amount);
            System.out.println("Withdrawal Successful");
        } else {
            System.out.println("Insufficient Balance or Invalid Account");
        }
    }

    static void balance(int acc) {
        if (accounts.containsKey(acc))
            System.out.println("Balance: " + accounts.get(acc));
        else
            System.out.println("Account Not Found");
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        accounts.put(1001, 5000.0);
        accounts.put(1002, 3000.0);

        while (true) {
            System.out.println("\n1. Deposit");
            System.out.println("2. Withdraw");
            System.out.println("3. Check Balance");
            System.out.println("4. Exit");

            int choice = sc.nextInt();

            if (choice == 4)
                break;

            System.out.print("Enter Account Number: ");
            int acc = sc.nextInt();

            if (choice == 1) {
                System.out.print("Enter Amount: ");
                deposit(acc, sc.nextDouble());
            } 
            else if (choice == 2) {
                System.out.print("Enter Amount: ");
                withdraw(acc, sc.nextDouble());
            } 
            else if (choice == 3) {
                balance(acc);
            } 
            else {
                System.out.println("Invalid Choice");
            }
        }

        sc.close();
    }
}
