
import java.util.*;

public class Main {
    static HashMap<Integer, Double> accounts = new HashMap<>();

    static void deposit(int account, double amount) {
        if (accounts.containsKey(account) && amount > 0) {
            accounts.put(account, accounts.get(account) + amount);
            System.out.println("Deposit Successful");
        } else {
            System.out.println("Invalid Transaction");
        }
    }

    static void withdraw(int account, double amount) {
        if (accounts.containsKey(account) && amount > 0 && accounts.get(account) >= amount) {
            accounts.put(account, accounts.get(account) - amount);
            System.out.println("Withdrawal Successful");
        } else {
            System.out.println("Insufficient Balance");
        }
    }

    static void checkBalance(int account) {
        if (accounts.containsKey(account)) {
            System.out.println("Balance: " + accounts.get(account));
        } else {
            System.out.println("Account Not Found");
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        accounts.put(1001, 5000.0);
        accounts.put(1002, 3000.0);

        while (true) {
            System.out.println("\n1. Deposit");
            System.out.println("2. Withdraw");
            System.out.println("3. Check Balance");
            System.out.println("4. Exit");

            int choice = sc.nextInt();

            if (choice == 4)
                break;

            System.out.print("Account Number: ");
            int account = sc.nextInt();

            if (choice == 1) {
                System.out.print("Amount: ");
                deposit(account, sc.nextDouble());
            } else if (choice == 2) {
                System.out.print("Amount: ");
                withdraw(account, sc.nextDouble());
            } else if (choice == 3) {
                checkBalance(account);
            } else {
                System.out.println("Invalid Choice");
            }
        }

        sc.close();
    }
}

