
import java.util.*;

class Student {
}

class Rockstar {
}

class Hacker {
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        Object[] objects = new Object[n];

        for (int i = 0; i < n; i++) {
            String type = sc.next();

            if (type.equals("Student")) {
                objects[i] = new Student();
            } else if (type.equals("Rockstar")) {
                objects[i] = new Rockstar();
            } else if (type.equals("Hacker")) {
                objects[i] = new Hacker();
            }
        }

        int student = 0;
        int rockstar = 0;
        int hacker = 0;

        for (Object obj : objects) {
            if (obj instanceof Student) {
                student++;
            } else if (obj instanceof Rockstar) {
                rockstar++;
            } else if (obj instanceof Hacker) {
                hacker++;
            }
        }

        System.out.println(student + " " + rockstar + " " + hacker);
    }
}

