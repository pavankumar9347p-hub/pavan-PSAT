
import java.util.*;

class Employee {
    String name;
    double salary;

    Employee(String name, double salary) {
        this.name = name;
        this.salary = salary;
    }

    void transformSalary(double percentage) {
        salary = salary + (salary * percentage / 100);
    }

    void display() {
        System.out.printf("%s %.2f%n", name, salary);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        Employee[] employees = new Employee[n];

        for (int i = 0; i < n; i++) {
            String name = sc.next();
            double salary = sc.nextDouble();
            employees[i] = new Employee(name, salary);
        }

        double percentage = sc.nextDouble();

        for (Employee employee : employees) {
            employee.transformSalary(percentage);
        }

        for (Employee employee : employees) {
            employee.display();
        }

        sc.close();
    }
}

